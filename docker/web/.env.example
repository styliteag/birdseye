# birdseye-web — see docs/web-ui.md

# NetBird management URL
WEB_NB_URL=https://netbird.example.com

# Public URL of this UI (behind your reverse proxy)
WEB_BASE_URL=https://birdseye.example.com

# openssl rand -hex 32
WEB_SESSION_SECRET=

# Register <WEB_BASE_URL><WEB_REDIRECT_PATH> in NetBird's dashboardRedirectURIs
WEB_REDIRECT_PATH=/auth/callback

# Optional
# WEB_CACHE_TTL=30
# WEB_SESSION_HOURS=12
# WEB_ANOMALY_IGNORE=^Z[0-9]{3}\b
# Anomalies: offline peers older than this many days are "stale"
# WEB_STALE_PEER_DAYS=30
# Anomalies: peers below this NetBird version are "outdated" (empty: newest seen)
# WEB_MIN_CLIENT_VERSION=0.40.0
# WEB_JOBS_DIR=/jobs        # plus the volumes in docker-compose.yml
# WEB_PORT=8080
TZ=Europe/Berlin
