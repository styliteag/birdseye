# --- NetBird API ------------------------------------------------------------
NB_URL=https://netbird.example.com
# Read-only token for the forwarder (events endpoint).
NB_API_KEY=nbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Admin token for the cleanup_ephemeral cron job (DELETE on /peers).
# Leave empty to disable the admin path (forwarder still works).
NB_ADMIN_API_KEY=nbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Forwarder --------------------------------------------------------------
POLL_INTERVAL=30
MAX_CATCHUP=200
OUTAGE_ALERT_MINUTES=10
BACKOFF_CAP_SECONDS=300

# Per-sink include filters. Comma-separated fnmatch globs over activity_code.
# Default: stdout/Mattermost see everything; email is curated to config changes.
STDOUT_INCLUDE=*
MATTERMOST_INCLUDE=*
EMAIL_INCLUDE=policy.*,user.*,setupkey.*,personalaccesstoken.*,account.*

# --- Mattermost (leave empty to disable) ------------------------------------
MATTERMOST_WEBHOOK_URL=
MATTERMOST_USERNAME=birdseye

# --- Email (EMAIL_MODE: off | immediate | digest) ---------------------------
EMAIL_MODE=off
EMAIL_DIGEST_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=netbird-audit@example.com
# Comma-separated recipients.
SMTP_TO=

# --- Cron (cron syntax; empty = disabled) -----------------------------------
CRON_CLEANUP_EPHEMERAL=*/15 * * * *
# Weekly NetBird volume backup. Empty = disabled. Default below: Sunday 03:00.
CRON_BACKUP_NETBIRD=0 3 * * 0
# Mirror this account's configuration onto a second controller. Dry run unless
# MIRROR_APPLY=true. Suggested: hourly at :25.
CRON_MIRROR_ACCOUNT=
# Refresh the standby clone: stage, install every target, drill. ~2 minutes.
# Suggested: every 6 hours, off the hour so it does not collide with anything.
CRON_CLONE_STANDBY=
# Ship a dated config archive to another host. Suggested: daily, early.
CRON_BACKUP_OFFSITE=

# --- Volume backup ----------------------------------------------------------
# Paths inside this container, comma-separated. Mount NetBird's named volumes
# read-only into the birdseye service (see docker-compose.yml) and list them
# here. Leave empty to disable the backup job.
BACKUP_PATHS=
# Passphrase for the 7z archive (AES256, filenames also encrypted).
# Store somewhere safe — without it the archive is unrecoverable.
BACKUP_ZIP_PASSWORD=
# Recipient(s) for the volume-backup mail; falls back to SMTP_TO if empty.
BACKUP_EMAIL_TO=
# Recipient(s) for the API-export mail (sent as a second mail in the same
# cron run when NB_ADMIN_API_KEY is set). Falls back to BACKUP_EMAIL_TO,
# then SMTP_TO.
EXPORT_EMAIL_TO=
# Hard cap (MB) on the attachment (applies to each of the two mails).
# If exceeded, an error mail is sent instead.
BACKUP_MAX_ATTACHMENT_MB=20
# Free-form tag that ends up in the mail subject and archive filename.
BACKUP_LABEL=prod
# Comma-separated 7z wildcard patterns matched case-insensitively against
# file names, recursive. Use to skip large derived files (GeoIP DBs,
# caches, ...) that can be re-downloaded instead of mailed weekly.
BACKUP_EXCLUDE=geo*

# --- Account mirror (mirror_account.py) --------------------------------------
# Copies posture checks, groups, networks, policies, DNS, users and account
# settings from NB_URL onto a second controller, matching objects by name.
# The source is opened read-only; the run aborts if both URLs are the same host.
# Peers cannot be created through the API, so this is NOT a failover target —
# see the standby clone below for that.
MIRROR_URL=
MIRROR_API_KEY=
# The scheduled run writes only when this is true; otherwise it reports drift.
MIRROR_APPLY=
# Delete objects on the target that the source does not have (default true —
# this is a mirror). Set to false for an additive import.
MIRROR_PRUNE=
# Limit to some sections, comma-separated. Empty = all of them:
# posture-checks,groups,networks,resources,routers,policies,routes,setup-keys,
# nameservers,dns-settings,users,peers,account
MIRROR_SECTIONS=
# Groups the controller maintains itself — mirrored by name, never created or
# deleted.
MIRROR_PROTECTED_GROUPS=All
# Where the pre-write dump of the target account is written (mount it to keep
# them). Empty disables the dump.
MIRROR_SNAPSHOT_DIR=/var/lib/birdseye/mirror

# --- Standby clone (clone_standby.py) ----------------------------------------
# Copies the *database* to a host you can fail over to by moving one DNS record.
# The SQLite stores are snapshotted with the online backup API — no downtime,
# no torn file — checksummed, rsynced, and installed by a generated install.sh
# that keeps the previous states for rollback.
CLONE_SSH_HOST=
CLONE_SSH_PORT=22
# Mount the key read-only; it needs root (or docker+write) on the standby.
CLONE_SSH_KEY=/run/secrets/standby_key
CLONE_SSH_KNOWN_HOSTS=
# yes | accept-new (trust on first use, the default) | no
CLONE_SSH_STRICT=accept-new
# Address to reach the standby on for verification, when it differs from the
# ssh host (or DNS does not answer for it yet). Empty = resolve CLONE_SSH_HOST.
CLONE_STANDBY_IP=
# The hostname this controller answers for. Empty = derived from NB_URL.
CLONE_PRIMARY_HOST=
#
# Live SQLite files to snapshot (mount the data directory read-only).
CLONE_DB_PATHS=/data/netbird/store.db,/data/netbird/idp.db,/data/netbird/events.db
# Where they land under each target root.
CLONE_DB_SUBDIR=data/netbird
# Config files installed into each target root by basename. In the copy shipped
# to a target whose HOST differs from the primary's, the primary hostname is
# replaced by that target's — one payload serves every target.
CLONE_CONFIG_FILES=/data/stack/config.yaml,/data/stack/dashboard.env
# Extra paths, `local:relative-to-target-root[:sync|seed]`. "seed" writes only
# what is not there yet (for data the service maintains itself). A wildcard in
# the local part is expanded and the destination is then a directory — use it
# for files whose name carries a date, e.g. GeoLite2-City_*.mmdb.
CLONE_TARGET_PATHS=
# Paths installed once per run at an absolute location on the standby — shared
# ingress assets, for instance. Same `local:remote[:sync|seed]` syntax.
CLONE_SHARED_PATHS=
#
# One or more stacks on the standby. The useful arrangement is two: a clone
# carrying the primary's identity (stopped, CERT_COPY=true) and a smoke test
# under the standby's own name (always running), so a drill disturbs nothing.
CLONE_TARGETS=real,test
CLONE_REAL_ROOT=/root/nb-real
CLONE_REAL_PROJECT=nb-real
CLONE_REAL_COMPOSE=docker-compose.yml
CLONE_REAL_HOST=netbird.example.com
CLONE_REAL_AUTOSTART=false
CLONE_REAL_CERT_COPY=true
CLONE_TEST_ROOT=/root/nb-test
CLONE_TEST_PROJECT=nb-test
CLONE_TEST_HOST=standby.example.com
CLONE_TEST_AUTOSTART=true
CLONE_TEST_CERT_COPY=false
# Which target `drill` and `failover` act on. Empty = the first one that does
# not start by itself.
CLONE_FAILOVER_TARGET=
#
# Certificate copy: a standby cannot issue the primary's certificate while DNS
# points at the primary, so it serves a copy, merged with the ingress stopped.
CLONE_ACME_SOURCE=/data/traefik/acme/acme.json
CLONE_ACME_REMOTE=/root/traefik/data/letsencrypt/acme.json
CLONE_INGRESS_ROOT=/root/traefik
CLONE_INGRESS_PROJECT=traefik
CLONE_INGRESS_COMPOSE=docker-compose.yml
#
# Pin these images to the digest the primary runs (needs the docker socket
# mounted read-only). The standby should run the binary that produced the
# database it holds, not whatever :latest resolves to over there.
CLONE_IMAGES=netbirdio/netbird-server,netbirdio/dashboard
CLONE_DOCKER_SOCKET=/var/run/docker.sock
# Refuse to ship a snapshot that fails this — protects the standby from being
# overwritten with an empty or wrong database.
CLONE_MIN_ROWS=accounts:1,peers:1
CLONE_KEEP_SNAPSHOTS=3
CLONE_PAYLOAD_DIR=
# Must not sit inside any path this job copies (the state volume often does).
CLONE_STAGE_DIR=/var/tmp/birdseye-clone-stage

# --- Offsite config archive (backup_offsite.py) ------------------------------
# A dated tar.gz of whole directories on another host — the thing you dig an
# old compose file out of three weeks later. Contains secrets: send it only
# somewhere that already holds data of the same sensitivity.
OFFSITE_SSH_HOST=
OFFSITE_SSH_PORT=22
OFFSITE_SSH_KEY=/run/secrets/standby_key
OFFSITE_SSH_KNOWN_HOSTS=
OFFSITE_SSH_STRICT=accept-new
OFFSITE_REMOTE_DIR=/root/backups
# What to pack (mount it read-only). Paths are stored relative to their common
# parent unless OFFSITE_BASE_DIR says otherwise. A wildcard entry is expanded
# at run time, so `/data/*` means "archive whatever is mounted under /data" and
# a new mount needs no change here. An entry matching nothing is an error, not
# a silent omission.
OFFSITE_PATHS=/data/*
OFFSITE_BASE_DIR=
# Live SQLite files: excluded from the tar pass above, then appended as
# consistent snapshots at the same path.
OFFSITE_DB_PATHS=/data/netbird/store.db
# tar patterns for large regenerable files.
OFFSITE_EXCLUDE=*.mmdb,*.BIN,__pycache__
OFFSITE_PREFIX=config-backup
OFFSITE_KEEP=14
OFFSITE_WORK_DIR=/var/tmp/birdseye-offsite
# Failure mail; falls back to BACKUP_EMAIL_TO, then SMTP_TO.
OFFSITE_EMAIL_TO=

# --- Checkmk (optional) ------------------------------------------------------
# Mail says a run failed; it cannot say a run stopped happening. Mount the
# agent's spool directory and the unattended jobs write a local check whose
# filename carries a max age, so a dead cron goes stale by itself.
CHECKMK_SPOOL_DIR=

# --- Timezone ---------------------------------------------------------------
TZ=Europe/Berlin
